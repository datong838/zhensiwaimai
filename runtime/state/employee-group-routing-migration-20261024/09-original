export async function runScheduled(...args) {
  if (args.length !== 0) throw new Error('runtime-options-forbidden:runScheduled');
  const workflowAttempts = [];
  let workflowReceipt = null;
  let pending;
  try {
    const readiness = await preflight();
    if (!readiness.ok) throw new Error(`daily-flow-environment-not-ready:${JSON.stringify(readiness)}`);
    const recovery = await evidenceRecovery();
    pending = await recovery.inspectPendingEvidence({
      root: EVIDENCE_ROOT, ledger: WECHAT_LEDGER, businessDate: yesterdayShanghai(),
      policyVersion: CONTROL_POLICY_VERSION,
    });
  } catch (error) {
    const failed = workflowExceptionReceipt(error, 0);
    const completionDisposition = classifyIncompleteDisposition(failed.reason);
    const decision = decisionForDisposition(completionDisposition, 'scheduled-evidence-recovery-preflight-failed');
    workflowAttempts.push(workflowAttempt(1, failed, decision));
    return Object.freeze({ ok: false, stage: 'workflow-incomplete', workflowReceipt: failed,
      sendResult: null, workflowAttempts: Object.freeze(workflowAttempts), controlDecision: decision,
      completionDisposition, runReview: failed.runReview, sendReview: [],
      reviewSummary: { workflow: failed.reviewSummary, wechat: null } });
  }
  if (pending.kind === 'blocked') {
    const failed = pending.receipt || workflowExceptionReceipt(new Error(pending.reason), 0);
    const completionDisposition = classifyIncompleteDisposition(pending.reason, true);
    const decision = decisionForDisposition(completionDisposition, 'scheduled-evidence-reconciliation-required');
    workflowAttempts.push(workflowAttempt(1, failed, decision));
    return Object.freeze({ ok: false, stage: 'wechat-send-failed', workflowReceipt: failed,
      sendResult: pending.marker ? { ok: false, receipt: pending.marker } : null,
      workflowAttempts: Object.freeze(workflowAttempts), controlDecision: decision,
      completionDisposition, runReview: failed.runReview, sendReview: pending.marker?.sendReview || [],
      reviewSummary: { workflow: failed.reviewSummary, wechat: pending.marker?.reviewSummary || null } });
  }
  if (pending.kind === 'resume' || pending.kind === 'completed') {
    workflowReceipt = await loadCompletedReceipt(pending.receiptFile);
    workflowAttempts.push(workflowAttempt(1, workflowReceipt,
      stopDecision('original-completed-workflow-evidence-reused')));
  }
  if (pending.kind === 'completed') {
    const completionDisposition = Object.freeze({ kind: 'completed', mayEndTurn: true,
      retryExternalEffect: false, requiredAction: 'report-completion-review',
      reason: 'scheduled-run-already-verified' });
    return Object.freeze({ ok: true, stage: 'completed', workflowReceipt,
      sendResult: { ok: true, receipt: pending.marker, reusedExisting: true, newSendAttempts: 0 },
      workflowAttempts: Object.freeze(workflowAttempts),
      controlDecision: codeDecision('complete', 'scheduled-run-already-verified'),
      completionDisposition, runReview: workflowReceipt.runReview,
      sendReview: pending.marker.sendReview || [],
      reviewSummary: { workflow: workflowReceipt.reviewSummary, wechat: pending.marker.reviewSummary || null } });
  }
  for (let attempt = 1; !workflowReceipt && attempt <= MAX_SCHEDULED_WORKFLOW_ATTEMPTS; attempt += 1) {
    const started = performance.now();
    try {
      workflowReceipt = await invokeFixed('runProduction', []);
    } catch (error) {
      workflowReceipt = workflowExceptionReceipt(error, Math.round(performance.now() - started));
      const completionDisposition = classifyIncompleteDisposition(workflowReceipt.reason);
      const decision = decisionForDisposition(completionDisposition, 'entrypoint-preflight-failed');
      workflowAttempts.push(workflowAttempt(attempt, workflowReceipt, decision));
      return Object.freeze({
        ok: false, stage: 'workflow-incomplete', workflowReceipt, sendResult: null,
        workflowAttempts: Object.freeze(workflowAttempts), controlDecision: decision, completionDisposition,
        runReview: workflowReceipt.runReview, sendReview: [],
        reviewSummary: { workflow: workflowReceipt.reviewSummary, wechat: null },
      });
    }
    if (workflowCompleted(workflowReceipt)) {
      const decision = stopDecision('workflow-completed');
      workflowAttempts.push(workflowAttempt(attempt, workflowReceipt, decision));
      break;
    }
    let decision;
    try {
      decision = await continuationDecision(workflowReceipt);
    } catch (error) {
      decision = stopDecision(`continuation-decision-failed:${String(error?.message ?? error)}`);
    }
    if (decision.allowed === true && attempt === MAX_SCHEDULED_WORKFLOW_ATTEMPTS) {
      decision = stopDecision('scheduled-workflow-attempt-budget-exhausted');
    }
    workflowAttempts.push(workflowAttempt(attempt, workflowReceipt, decision));
    if (decision.allowed !== true) {
      const completionDisposition = classifyIncompleteDisposition(`${decision.code}:${workflowReceipt?.reason || ''}`);
      decision = decisionForDisposition(completionDisposition, decision.code);
      workflowAttempts[workflowAttempts.length - 1] = workflowAttempt(attempt, workflowReceipt, decision);
      return Object.freeze({
        ok: false, stage: 'workflow-incomplete', workflowReceipt, sendResult: null,
        workflowAttempts: Object.freeze(workflowAttempts), controlDecision: decision, completionDisposition,
        runReview: workflowReceipt.runReview || [], sendReview: [],
        reviewSummary: { workflow: workflowReceipt.reviewSummary || null, wechat: null },
      });
    }
  }
  const sendStarted = performance.now();
  let sendResult;
  try {
    sendResult = await sendScheduledEvidence(workflowReceipt.receiptFile);
  } catch (error) {
    sendResult = sendExceptionResult(workflowReceipt, error, Math.round(performance.now() - sendStarted));
  }
  const completed = sendResult.ok === true && sendResult.receipt?.verified === true;
  const sendEffectUnknown = sendResult.receipt?.sendAttempts > 0 || sendResult.receipt?.state === 'unknown';
  const completionDisposition = completed ? Object.freeze({
    kind: 'completed', mayEndTurn: true, retryExternalEffect: false,
    requiredAction: 'report-completion-review', reason: 'scheduled-run-completed',
  }) : classifyIncompleteDisposition(sendResult.receipt?.reason, sendEffectUnknown);
  const decision = completed
    ? codeDecision('complete', 'scheduled-run-completed')
    : decisionForDisposition(completionDisposition, sendEffectUnknown
      ? 'wechat-external-effect-not-verified'
      : 'wechat-failure-requires-executor-maintenance');
  return Object.freeze({
    ok: completed,
    stage: completed ? 'completed' : 'wechat-send-failed',
    workflowReceipt,
    sendResult,
    workflowAttempts: Object.freeze(workflowAttempts),
    controlDecision: decision,
    completionDisposition,
    runReview: workflowReceipt.runReview,
    sendReview: sendResult.receipt?.sendReview || [],
    ...(completed ? {} : { experienceReview: lookupHistoricalExperience(sendResult.receipt) }),
    reviewSummary: { workflow: workflowReceipt.reviewSummary, wechat: sendResult.receipt?.reviewSummary || null },
  });
}

