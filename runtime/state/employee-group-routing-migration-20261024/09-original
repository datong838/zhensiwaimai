    pitfalls: [{ code: 'fixed-profile-started', reason: 'stale-state-pid-restarted-same-dedicated-profile' }] });
  if (genericTimeout.caseId !== 'wechat-preflight-timeout-unproven'
      || genericTimeout.effectBoundary !== 'unknown'
      || genericTimeout.mayRetryExternalEffect !== false) return { ok: false, caseCount: HISTORICAL_EXPERIENCE_CASES.length };
  if (taobaoColdStart.caseId !== 'taobao-fixed-profile-stopped' || taobaoColdStart.mayRetryExternalEffect !== false
      || HISTORICAL_EXPERIENCE_CASES.length !== 7) return { ok: false, caseCount: HISTORICAL_EXPERIENCE_CASES.length };
  const taobaoActivityShell = lookupHistoricalExperience({ stage: 'taobao_task_open', clickAttempts: { download: { store: 0 } }, pitfalls: [{
    code: 'auth-anchor-recovery', reason: 'unique-taobao-activity-shell-shopid-matched-live-frames',
  }] });
  if (taobaoActivityShell.caseId !== 'taobao-activity-shell-auth-anchor'
      || taobaoActivityShell.effectBoundary !== 'send-not-applicable-production-receipt'
      || taobaoActivityShell.mayRetryExternalEffect !== false) return { ok: false, caseCount: HISTORICAL_EXPERIENCE_CASES.length };
  return { ok: true, caseCount: HISTORICAL_EXPERIENCE_CASES.length, tests: 14 };
}

function decisionForDisposition(disposition, code) {
  const actions = {
    'await-user-authentication': 'await-user',
    'reconcile-external-effect': 'reconcile-only',
    'repair-and-resume': 'repair-and-resume',
  };
  return codeDecision(actions[disposition.kind], code);
}

function workflowCompleted(receipt) {
  return receipt?.ok === true
    && receipt?.stage === 'completed'
    && receipt?.phase === 'completed'
    && receipt?.cleanupStatus === 'completed'
    && Array.isArray(receipt?.runReview)
    && receipt?.reviewSummary?.controlPolicyVersion === CONTROL_POLICY_VERSION;
}

function failedReview(stage, label, reason, elapsedMs) {
  const row = Object.freeze({
    item: 1, stage, label, elapsedMs, status: 'failed',
    pitfalls: [Object.freeze({ code: 'run-failure', reason })],
  });
  return Object.freeze({
    rows: Object.freeze([row]),
    summary: Object.freeze({ totalElapsedMs: elapsedMs, itemCount: 1, pitfallCount: 1, result: 'failed' }),
  });
}

function workflowExceptionReceipt(error, elapsedMs) {
  const reason = String(error?.message ?? error);
  const review = failedReview('entrypoint_preflight', '固定入口完整性预检', reason, elapsedMs);
  return Object.freeze({
    ok: false, executor: 'daily-taobao-installed-entrypoint', stage: 'entrypoint_preflight',
    runtimeModelDecisions: 0, reason, elapsedMs, stageMs: { entrypoint_preflight: elapsedMs },
    runReview: review.rows, reviewSummary: review.summary,
  });
}

function sendExceptionResult(workflowReceipt, error, elapsedMs) {
  const reason = String(error?.message ?? error);
  const review = failedReview('sender_integrity_preflight', '微信发送器完整性预检', reason, elapsedMs);
  const receipt = Object.freeze({
    ok: false, executor: 'daily-taobao-scheduled-wechat-gate', channel: 'desktop',
    groupName: workflowReceipt?.evidenceManifest?.groupName || null, payloadType: 'image',
    sendAttempts: 0, runtimeModelDecisions: 0, stage: 'sender_integrity_preflight', reason,
    elapsedMs, stageMs: { sender_integrity_preflight: elapsedMs },
    sendReview: review.rows, reviewSummary: review.summary,
  });
  return Object.freeze({
    ok: false, groupName: receipt.groupName,
    imageSha256: (workflowReceipt?.evidenceManifest?.images || []).map((item) => item.sha256),
    channel: 'desktop', authorizationMode: 'scheduled-standing',
    resourceWaitAttempts: 0, resourceWaitMs: elapsedMs, receipt,
  });
}

async function continuationDecision(receipt) {
  const implementation = await executor();
  const decision = implementation.scheduledContinuationDecision(receipt);
  if (decision?.authority !== 'executor-code-only' || typeof decision?.allowed !== 'boolean') {
    throw new Error('scheduled-continuation-decision-invalid');
  }
  return decision;
}

function workflowAttempt(attempt, receipt, decision) {
  return Object.freeze({
    attempt, ok: receipt?.ok === true, runId: receipt?.runId || null,
    stage: receipt?.stage || null, receiptFile: receipt?.receiptFile || null,
    runReview: receipt?.runReview || [], reviewSummary: receipt?.reviewSummary || null,
    experienceReview: lookupHistoricalExperience(receipt),
    continuationDecision: decision,
  });
}

