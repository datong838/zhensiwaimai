const sha256 = (value) => crypto.createHash('sha256').update(value).digest('hex');

async function executor() {
  const source = await fs.readFile(SOURCE);
  const actual = sha256(source);
  if (actual !== EXECUTOR_SHA256) throw new Error('executor-code-drift');
  return import(`file://${SOURCE}?sha256=${actual}`);
}

async function wechatSender() {
  const source = await fs.readFile(WECHAT_SOURCE);
  const actual = sha256(source);
  if (actual !== WECHAT_SHA256) throw new Error('wechat-sender-code-drift');
  return import(`file://${WECHAT_SOURCE}?sha256=${actual}`);
}

async function evidenceRecovery() {
  const source = await fs.readFile(RECOVERY_SOURCE);
  const actual = sha256(source);
  if (actual !== RECOVERY_SHA256) throw new Error('scheduled-evidence-recovery-code-drift');
  return import(`file://${RECOVERY_SOURCE}?sha256=${actual}`);
}

function yesterdayShanghai(now = new Date()) {
  const date = new Date(now.toLocaleString('en-US', { timeZone: 'Asia/Shanghai' }));
  date.setDate(date.getDate() - 1);
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
}

async function loadCompletedReceipt(receiptFile) {
  if (typeof receiptFile !== 'string') throw new Error('receipt-path-required');
  const resolved = path.resolve(receiptFile);
  if (!resolved.startsWith(`${EVIDENCE_ROOT}/`) || path.basename(resolved) !== 'receipt.json') throw new Error('receipt-path-out-of-scope');
  const receipt = JSON.parse(await fs.readFile(resolved, 'utf8'));
  if (receipt.ok !== true || receipt.stage !== 'completed' || receipt.phase !== 'completed' || receipt.cleanupStatus !== 'completed') throw new Error('receipt-not-completed');
  if (receipt.evidenceManifest?.runId !== receipt.runId || receipt.evidenceManifest?.businessDate !== receipt.businessDate) throw new Error('receipt-manifest-mismatch');
  const expectedDir = path.join(EVIDENCE_ROOT, `${receipt.businessDate}-${receipt.runId}`);
  if (path.dirname(resolved) !== expectedDir) throw new Error('receipt-directory-mismatch');
  return receipt;
}

export async function preflight() {
  try {
    const [canonicalSkill, installedSkill, canonicalEntry, installedEntry] = await Promise.all([
      fs.readFile(CANONICAL_SKILL),
      fs.readFile(INSTALLED_SKILL),
      fs.readFile(CANONICAL_ENTRYPOINT),
      fs.readFile(INSTALLED_ENTRYPOINT),
    ]);
    const canonicalSkillSha256 = sha256(canonicalSkill);
    const installedSkillSha256 = sha256(installedSkill);
    if (canonicalSkillSha256 !== installedSkillSha256) throw new Error('installed-skill-drift');
    const canonicalEntrySha256 = sha256(canonicalEntry);
    const installedEntrySha256 = sha256(installedEntry);
    if (canonicalEntrySha256 !== installedEntrySha256) throw new Error('installed-entrypoint-drift');
    const experienceSelfTest = selfTestHistoricalExperience();
    if (experienceSelfTest.ok !== true) throw new Error('historical-experience-self-test-failed');
    const implementation = await executor();
    const selfTest = implementation.selfTest();
    if (selfTest.ok !== true) throw new Error('executor-self-test-failed');
    const launcherDependencySelfTest = await implementation.dedicatedChromeLauncherSelfTest();
    if (launcherDependencySelfTest.ok !== true) throw new Error('dedicated-chrome-launcher-self-test-failed');
    const taobaoStartupSelfTest = await implementation.taobaoStartupSelfTest();
    if (taobaoStartupSelfTest.ok !== true) throw new Error('taobao-startup-contract-self-test-failed');
    const sender = await wechatSender();
    const wechatSelfTest = sender.selfTest();
    if (wechatSelfTest.ok !== true) throw new Error('wechat-sender-self-test-failed');
    const recovery = await evidenceRecovery();
    const pendingEvidence = await recovery.inspectPendingEvidence({
      root: EVIDENCE_ROOT, ledger: WECHAT_LEDGER, businessDate: yesterdayShanghai(),
      policyVersion: CONTROL_POLICY_VERSION,
    });
    return Object.freeze({
      ok: true,
      executor: SOURCE,
      executorSha256: EXECUTOR_SHA256,
      channel: 'control-background-dedicated-chrome',
      fixedProfiles: selfTest.fixedProfiles,
      desktopJinshaAllowed: false,
      skillSync: true,
      skillSha256: canonicalSkillSha256,
      entrypointSync: true,
      entrypointSha256: canonicalEntrySha256,
      experienceSelfTest,
      selfTest,
      launcherDependencySelfTest,
      taobaoStartupSelfTest,
      wechatSelfTest,
      pendingEvidence: { kind: pendingEvidence.kind, receiptFile: pendingEvidence.receiptFile || null,
        reason: pendingEvidence.reason || null },
    });
  } catch (error) {
    return { ok: false, executor: SOURCE, reason: String(error?.message ?? error) };
  }
}

async function invokeFixed(exportName, args) {
  if (args.length !== 0) throw new Error(`runtime-options-forbidden:${exportName}`);
  const readiness = await preflight();
  if (!readiness.ok) throw new Error(`daily-flow-environment-not-ready:${JSON.stringify(readiness)}`);
  const implementation = await executor();
  const action = implementation[exportName];
  if (typeof action !== 'function') throw new Error(`fixed-entrypoint-missing:${exportName}`);
  return action();
}

function codeDecision(action, code) {
  return Object.freeze({ authority: 'executor-code-only', allowed: false, action, code });
}

function stopDecision(code) {
  return codeDecision('stop', code);
}

export function classifyIncompleteDisposition(reason, externalEffectUnknown = false) {
  const normalized = String(reason || '').toLowerCase();
  const authenticationRequired = /(?:login|captcha|otp|verification-code|account-risk|risk-control|登录|验证码|账号风控)/.test(normalized);
  if (authenticationRequired) {
    return Object.freeze({
      kind: 'await-user-authentication', mayEndTurn: true, retryExternalEffect: false,
      requiredAction: 'user-authentication', reason: String(reason || 'authentication-required'),
    });
  }
  if (externalEffectUnknown || /(?:upload-result-unknown|external-effect-not-verified|attempted|unknown)/.test(normalized)) {
    return Object.freeze({
      kind: 'reconcile-external-effect', mayEndTurn: false, retryExternalEffect: false,
      requiredAction: 'code-owned-read-only-reconciliation', reason: String(reason || 'external-effect-unknown'),
    });
  }
  return Object.freeze({
    kind: 'repair-and-resume', mayEndTurn: false, retryExternalEffect: false,
    requiredAction: 'update-plan-repair-test-pin-preflight-resume-same-entrypoint', reason: String(reason || 'non-login-failure'),
  });
}

function effectBoundary(receipt) {
  if (!Object.hasOwn(receipt || {}, 'sendAttempts') && receipt?.clickAttempts) return 'send-not-applicable-production-receipt';
  if (receipt?.sendAttempts === 0
      && (receipt.items || []).every((item) => item?.sendAttempts === 0
        && !['attempted', 'unknown', 'partial'].includes(item?.status))) return 'proven-zero';
  if (receipt?.sendAttempts > 0
      || (receipt.items || []).some((item) => item?.sendAttempts > 0
        || ['attempted', 'unknown', 'partial'].includes(item?.status))) return 'attempted-or-unknown';
  return 'unknown';
}

export function lookupHistoricalExperience(receipt = {}) {
  const reason = String(receipt?.reason || '');
  const stage = String(receipt?.stage || '');
  const pitfalls = Array.isArray(receipt?.pitfalls) ? receipt.pitfalls : [];
  const input = { reason, stage, pitfalls };
  const match = HISTORICAL_EXPERIENCE_CASES.find((item) => item.match(input));
  return Object.freeze({
    status: match ? 'matched' : 'unmatched',
    caseId: match?.id || 'history-review-required',
    reference: match?.reference || '先阅读本流程技术方案及相邻历史成功/失败收据，再提出新方案并为新案例补正反测试。',
    lesson: match?.lesson || '没有精确历史案例命中；禁止按报错文案直接猜测修复。',
    requiredEvidence: match?.requiredEvidence || ['read-project-plan', 'read-prior-success-receipts', 'add-case-and-regression-test'],
    forbidden: match?.forbidden || ['ad-hoc-recovery', 'external-effect-retry-without-code-proof'],
    effectBoundary: effectBoundary(receipt),
    mayRetryExternalEffect: false,
  });
}

