<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>ZENSI_ADB_SERIAL</key>
		<string></string>
		<key>ZENSI_NODE</key>
		<string>__NODE__</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.zhensi.waimai.careloop</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PYTHON__</string>
		<string>__RUNTIME__/run_all.py</string>
		<string>--daemon</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__RUNTIME__/state/daemon.err.log</string>
	<key>StandardOutPath</key>
	<string>__RUNTIME__/state/daemon.out.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>__RUNTIME__</string>
</dict>
</plist>
