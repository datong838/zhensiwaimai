# Actual credentials only; business state and handover data are versioned.
.env
.env.*
!.env.example
*.pem
*.key

# Installed dependencies (the existing self-contained vendor bundle is versioned).
**/node_modules
!vendor/node_modules/
!vendor/node_modules/**

# Reproducible caches and operating-system metadata, not business records.
**/__pycache__/
**/.pytest_cache/
*.pyc
.DS_Store
vendor/node_modules/**/__pycache__/
vendor/node_modules/**/.DS_Store
